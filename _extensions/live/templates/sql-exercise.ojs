_sql_value_{{block_id}} = {
  const { SqlEvaluator, b64Decode } = window._exercise_ojs_runtime;

  if (!window.__sqlOjs) {
    window.__sqlOjs = {
      renderedOjs: {},
      process: async (context, inputs) => {
        const evaluator = new SqlEvaluator(context);
        await evaluator.process(inputs);
        return evaluator.container;
      }
    };
  }

  const sqlOjs = window.__sqlOjs;

  const scriptContent = document.querySelector(`script[type="sql-{{block_id}}-contents"]`).textContent;
  const block = JSON.parse(b64Decode(scriptContent));

  const options = Object.assign(
    {
      id: "sql-{{block_id}}-contents",
      echo: true,
      output: true,
      envir: `exercise-env-${block.attr.exercise}`,
    },
    block.attr
  );

  const result = sqlOjs.process({ code: block.code, options }, {{block_input}});

  if (options.output && !("{{block_id}}" in sqlOjs.renderedOjs)) {
    const container = document.createElement("div");
    const spinner = document.createElement("div");
    spinner.className = "spinner-border spinner-border-sm";
    container.appendChild(spinner);
    yield container;
  }

  sqlOjs.renderedOjs["{{block_id}}"] = true;
  yield await result;
}

_sql_feedback_{{block_id}} = {
  const { SqlGrader } = window._exercise_ojs_runtime;
  const emptyFeedback = document.createElement("div");

  const evaluator = _sql_value_{{block_id}}?.value?.evaluator;
  if (!evaluator) return emptyFeedback;

  const grader = new SqlGrader(evaluator);
  const feedback = await grader.gradeExercise();
  if (!feedback) return emptyFeedback;
  return feedback;
}